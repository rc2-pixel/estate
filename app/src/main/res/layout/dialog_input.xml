<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 土地情報 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【土地情報】"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="4dp"/>

        <EditText android:id="@+id/etArea"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="土地面積（㎡）" android:inputType="numberDecimal"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="地目" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerLandCategory"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <EditText android:id="@+id/etFrontage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="間口（m）" android:inputType="numberDecimal"/>

        <EditText android:id="@+id/etRoadWidth"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="道路幅（m）" android:inputType="numberDecimal"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="道路向き" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerRoadDirection"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- 建物情報 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【建物情報】"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>

        <!-- 床面積（建物情報の一番上） -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="床面積" android:textStyle="bold" android:layout_marginBottom="4dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="1階" android:gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <EditText android:id="@+id/etFloorArea1"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="㎡" android:inputType="numberDecimal"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="2階" android:gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <EditText android:id="@+id/etFloorArea2"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="㎡" android:inputType="numberDecimal"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="3階" android:gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <EditText android:id="@+id/etFloorArea3"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="㎡" android:inputType="numberDecimal"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="合計" android:gravity="center_vertical" android:layout_marginEnd="4dp"
                android:textStyle="bold"/>
            <EditText android:id="@+id/etFloorAreaTotal"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="㎡" android:inputType="numberDecimal"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="構造" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerStructure"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="築年" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerBuiltYear"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="階数" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerFloors"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="間取り" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="駐車" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerParking"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="上水道" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerWaterSupply"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="下水道" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerSewage"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- メモ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【メモ】"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>

        <EditText android:id="@+id/etMemo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="メモ" android:minLines="3" android:gravity="top"/>

    </LinearLayout>
</ScrollView>
