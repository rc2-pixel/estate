<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 所在地・位置情報 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ 所在地・位置情報"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="6dp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvDetailAddress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:padding="4dp"/>

        <TextView android:id="@+id/tvDetailLatLng"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#666666" android:padding="4dp"/>

        <TextView android:id="@+id/tvDetailAltitude"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#666666" android:padding="4dp"/>

        <TextView android:id="@+id/tvDetailDate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#666666" android:padding="4dp"/>

        <!-- 床面積 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ 床面積"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvDetailFloorAreas"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:padding="4dp"/>

        <!-- 土地情報 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ 土地情報"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvDetailLand"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:padding="4dp"/>

        <!-- 建物情報 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ 建物情報"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvDetailBuilding"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:padding="4dp"/>

        <!-- メモ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ メモ"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvDetailMemo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:padding="4dp"/>

    </LinearLayout>
</ScrollView>
